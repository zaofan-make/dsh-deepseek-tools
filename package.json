{
  "name": "@zaofan/dsh-deepseek-tools",
  "version": "0.1.1",
  "description": "DeepSeek 全家桶五件套（联网搜索 / 读链接 / OCR / ASR / TTS）—— 五个工具对所有会话可见，配置在插件页里直接改。",
  "icon": "./icon.png",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "search",
    "ocr",
    "asr",
    "tts"
  ],
  "files": [
    "dist",
    "client.js",
    "icon.png",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PITFALLS.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "manifestVersion": 1
  }
}
